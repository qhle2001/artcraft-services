# Copy to .env in this directory. Use unique random values and never commit .env.

# Host-published API bind. Keep loopback when a host reverse proxy terminates TLS.
API_BIND_HOST=127.0.0.1
API_BIND_PORT=12345

# MySQL and SeaweedFS credentials. Prefer hex strings to avoid Compose interpolation.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_SECRET
S3_ACCESS_KEY=REPLACE_WITH_RANDOM_ID
S3_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# Browser session settings. COOKIE_DOMAIN should be the shared parent domain for
# the API and frontend, such as .example.com. COOKIE_SECRET must be long and random.
COOKIE_DOMAIN=.example.com
COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET
SORT_KEY_SECRET=REPLACE_WITH_RANDOM_SECRET
WEBSITE_HOMEPAGE_REDIRECT=https://app.example.com
# Comma-separated exact browser frontend origins; no paths or wildcards.
CORS_ALLOWED_ORIGINS=https://app.example.com
MEDIA_CDN_BASE_URL=https://media.example.com
COOKIE_HTTP_ONLY=true
ENABLE_PAGING=false
NUM_WORKERS=4

# GoClaw URL, API token and agents are configured in goclaw/config.json.
# Copy goclaw/config.example.json to that path. Compose mounts it read-only.

# storyteller-web currently requires these at startup even when GoClaw handles AI.
# Keep provider features unused until you deliberately configure and enable them.
FAL_API_KEY=unset
FAL_WEBHOOK_URL=https://api.example.com/v1/webhooks/fal
GMICLOUD_API_KEY=unset
GROK_API_KEY=unset
OPENAI_API_KEY=unset
WORLDLABS_API_KEY=unset
BEEBLE_API_KEY=unset
BEEBLE_WEBHOOK_URL=https://api.example.com/v1/webhooks/beeble
SEEDANCE2PRO_COOKIES=unset
SEEDANCE2PRO_WHITELIST_COOKIES=unset
SEEDANCE2PRO_BYTEPLUS_ULTRA_COOKIES=unset

# Email confirmation/recovery needs a working Resend key and verified sender setup.
RESEND_API_KEY=unset

# Stripe settings are required by current startup code, even if billing is not used.
STRIPE_SECRET_KEY=unset
STRIPE_SECRET_WEBHOOK_SIGNING_KEY=unset
STRIPE_FAKEYOU_ACCOUNT_ID=unset
STRIPE_PORTAL_DEFAULT_CONFIG_ID=unset
STRIPE_CHECKOUT_SUCCESS_URL_PATH=/checkout_success
STRIPE_CHECKOUT_CANCEL_URL_PATH=/checkout_cancel
STRIPE_PORTAL_RETURN_URL_PATH=/portal_success
STRIPE_ARTCRAFT_ACCOUNT_ID=unset
STRIPE_ARTCRAFT_SECRET_KEY=unset
STRIPE_ARTCRAFT_SECRET_WEBHOOK_KEY=unset
STRIPE_ARTCRAFT_CHECKOUT_SUCCESS_URL=https://app.example.com/checkout_success
STRIPE_ARTCRAFT_CHECKOUT_CANCEL_URL=https://app.example.com/checkout_cancel
STRIPE_ARTCRAFT_PORTAL_RETURN_URL=https://app.example.com/portal_closed
